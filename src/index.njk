---
title: صفحه اصلی
---
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <title>وب‌سایت خبری</title>
</head>
<body style="font-family: sans-serif; max-width: 800px; margin: 40px auto; padding: 0 20px;">
  <h1>آخرین اخبار</h1>
  <ul>
  {% for post in collections.all %}
    {% if "src/news" in post.inputPath %}
      <li style="margin-bottom: 15px;">
        <a href="{{ ('/news/' ~ post.fileSlug ~ '/') | url }}" style="font-size: 1.2rem; color: #0066cc;">
          {{ post.data.title or post.fileSlug }}
        </a>
      </li>
    {% endif %}
  {% else %}
    <li>هیچ خبری یافت نشد.</li>
  {% endfor %}
  </ul>
</body>
</html>
