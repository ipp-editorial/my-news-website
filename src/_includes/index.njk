---
title: صفحه اصلی
---
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <title>وب‌سایت خبری</title>
</head>
<body style="font-family: sans-serif; max-width: 800px; margin: 40px auto; padding: 0 20px;">
  <h1>آخرین اخبار</h1>
  <ul>
  {% for post in collections.news %}
    <li>
      <a href="{{ post.url }}">{{ post.data.title }}</a>
    </li>
  {% else %}
    <li>هیچ خبری یافت نشد.</li>
  {% endfor %}
  </ul>
</body>
</html>
