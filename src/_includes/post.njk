---
layout: base.njk
---

<article style="max-width: 800px; margin: 40px auto; padding: 0 20px; font-family: sans-serif; direction: rtl; line-height: 1.8;">
  <h1 style="font-size: 2rem; color: #111; margin-bottom: 10px;">{{ title }}</h1>
  
  {% if date %}
    <time style="color: #666; font-size: 0.9rem; display: block; margin-bottom: 20px;">
      {{ date | readableDate }}
    </time>
  {% endif %}

  <hr style="border: none; border-top: 1px solid #eee; margin-bottom: 25px;">

  {% if image %}
    <img src="{{ image | url }}" alt="{{ title }}" style="width: 100%; max-height: 450px; object-fit: cover; border-radius: 8px; margin-bottom: 25px;">
  {% endif %}

  <div style="font-size: 1.1rem; color: #333;">
    {{ content | safe }}
  </div>

  <div style="margin-top: 40px;">
    <a href="{{ '/' | url }}" style="color: #0066cc; text-decoration: none;">← بازگشت به صفحه اصلی</a>
  </div>
</article>
